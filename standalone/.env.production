# Production environment configuration for 200 QPS optimization

# Rate limiting - allow higher limits for production
RATELIMIT_IP_HEADER=X-Forwarded-For

# CORS optimization - specify specific origins in production instead of true
# CORS_ORIGIN=https://yourdomain.com

# Basic auth for production (base64 encoded username:password)
# BASIC_AUTH=

# Hide rate limit warnings in production
HIDE_RATELIMIT_IP_WARNING=true

# Node.js/Bun performance optimizations
NODE_ENV=production

# Optimize garbage collection for high throughput
# For Bun, these are handled automatically, but you can tune if needed
